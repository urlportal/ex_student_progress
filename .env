# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> docker / deploy ###
# Имя приложения — используется как префикс имён контейнеров, сетей и volumes
APP_NAME=student-progress
# Слот blue/green деплоя; для локальной разработки — "local"
SLOT=local
# UID/GID пользователя внутри контейнера; переопределите в .env.local, если id -u != 1000
CONTAINER_EXEC_USER_ID=1000
CONTAINER_EXEC_GROUP_ID=1000
# Имена внешних Docker-volumes (используются в production)
VOLUME_NAME_POSTGRES_DATA=student-progress-postgres-data
VOLUME_NAME_COMPOSER_CACHE=student-progress-composer-cache
VOLUME_NAME_ELASTICSEARCH_DATA=student-progress-elasticsearch-data
# Имя Traefik-сети (production); в dev2 переопределяется на локальную сеть
TRAEFIK_NETWORK=traefik
# Путь деплоя на сервере (production); локально любое значение — нужно лишь для подстановки переменных
DEPLOY_DIR=/tmp/deploy
# Переменные для запуска тестов в пайплайне. Локально не нужны
TESTING_DB_NAME='db'
TESTING_DB_USER='test_user'
TESTING_DB_PASSWORD='test_pass123!'
###< docker / deploy ###

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=srv_student_progress

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=18"
###< doctrine/doctrine-bundle ###

###> elasticsearch ###
ELASTICSEARCH_URL=http://elasticsearch:9200
###< elasticsearch ###

###> redis ###
REDIS_URL=redis://redis:6379
###< redis ###

###> rabbitmq ###
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
###< rabbitmq ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/%2f"
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=7b2eda34e019967adc92e427e4218e27ec55678f3679e4cb8ff58be1ffe1c82c
###< lexik/jwt-authentication-bundle ###
